// ─────────────────────────────────────────────────────────────────────────────
// Example 1: Basic Persona Definition
// ─────────────────────────────────────────────────────────────────────────────

/// A security analyst persona that identifies and mitigates risks
pub persona SEC {
  id: "SEC"
  name: "Security Analyst"
  intent: "Identify and mitigate security vulnerabilities"
  tone: vigilant
  
  skills {
    "OWASP Top 10"
    "STRIDE threat modeling"
    "Penetration testing"
    "Zero Trust architecture"
    "Security code review"
  }
  
  constraints {
    "Always assume breach"
    "Apply least privilege principle"
    maxResponseTime <= 5s
  }
  
  tags {
    security
    compliance
    audit
  }
  
  @onActivate {
    log.info("Security analysis mode engaged")
  }
  
  pub fn analyze(target: String) -> SecurityReport {
    // Perform security analysis
    let threats = identifyThreats(target)
    let vulnerabilities = scanVulnerabilities(target)
    
    return SecurityReport {
      threats,
      vulnerabilities,
      recommendations: generateRecommendations(threats, vulnerabilities),
      riskScore: calculateRiskScore(threats, vulnerabilities)
    }
  }
  
  pub async fn scan(url: String) -> Result<ScanResult, Error> {
    try {
      let result = await performScan(url)
      return Ok(result)
    } catch (e) {
      return Err(e)
    }
  }
}


// ─────────────────────────────────────────────────────────────────────────────
// Example 2: Team Definition with Composition
// ─────────────────────────────────────────────────────────────────────────────

/// A security review team combining multiple perspectives
pub team SecurityReview {
  members: [SEC, AUDIT, ARCHI, CRITIC]
  primary: SEC
  merge: Debate
  quorum: 3/4
  conflict: SEC > AUDIT > ARCHI > CRITIC
  
  domain: "security"
  escalation: "security-team@company.com"
  
  @onComplete(result) {
    if result.riskScore > 7 {
      notify("security-alerts", result)
    }
  }
}


// ─────────────────────────────────────────────────────────────────────────────
// Example 3: Workflow Definition
// ─────────────────────────────────────────────────────────────────────────────

/// Code review workflow with parallel security and architecture analysis
pub workflow CodeReview<T: Reviewable> {
  input: T
  output: ReviewResult
  
  // Sequential with parallel branches
  steps: DEV -> (ARCHI || SEC) -> CRITIC -> merge(Consensus)
  
  timeout: 60s
  retry: {
    count: 3,
    delay: 5s,
    backoff: exponential
  }
  fallback: SIMPLIFY
  
  when: input.linesChanged > 10
  
  @onStep(step) {
    log.debug(`Processing step: ${step.name}`)
    metrics.increment("workflow.steps")
  }
  
  @onComplete(result) {
    if result.approved {
      notifyAuthor("Review approved!")
    } else {
      notifyAuthor("Changes requested", result.comments)
    }
  }
  
  @onError(error) {
    log.error(`Workflow failed: ${error.message}`)
    alert("review-failures", error)
  }
}


// ─────────────────────────────────────────────────────────────────────────────
// Example 4: Type Definitions
// ─────────────────────────────────────────────────────────────────────────────

/// Discriminated union for command results
type CommandResult = 
  | { status: "success", data: Any }
  | { status: "error", error: Error }
  | { status: "pending", progress: Float };

/// Security persona subset
type SecurityPersona = SEC | AUDIT | COMPLIANCE;

/// Full stack developer intersection
type FullStackDev = DEV & ARCHI & UX;

/// Generic container with constraints
type Container<T: Serializable> = {
  items: Array<T>,
  count: Int,
  metadata: Map<String, Any>
};

/// Interface for reviewable items
interface Reviewable {
  id: String
  content: String
  author: String
  linesChanged: Int
  
  fn getChanges() -> Array<Change>
  fn getMetadata() -> Map<String, Any>
}


