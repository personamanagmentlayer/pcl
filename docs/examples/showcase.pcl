// ─────────────────────────────────────────────────────────────────────────────
// Example 6: Advanced Persona with Generics
// ─────────────────────────────────────────────────────────────────────────────

/// Generic data processor persona
pub persona DataProcessor<T: Processable, R: Reportable> {
  intent: "Process and transform data"
  tone: analytical
  
  skills {
    @Foundation.DataProcessing
    "ETL pipelines"
    "Data validation"
    "Schema mapping"
  }
  
  pub fn process(input: T) -> Result<R, ProcessingError> {
    let validated = validate(input)
    if !validated.ok {
      return Err(validated.error)
    }
    
    let transformed = transform(validated.value)
    let output = format<R>(transformed)
    
    return Ok(output)
  }
  
  pub async fn processStream(
    input: Stream<T>
  ) -> AsyncIterator<Result<R, ProcessingError>> {
    for await item in input {
      yield process(item)
    }
  }
}


// ─────────────────────────────────────────────────────────────────────────────
// Example 7: Module and Imports
// ─────────────────────────────────────────────────────────────────────────────

import { SEC, AUDIT } from "@pcl/security"
import { DEV, ARCHI } from "@pcl/engineering"
import * as Workflows from "@pcl/workflow"
import type { Config, Options } from "./config"

export { SecurityReview, CodeReview }
export default persona SEC


// ─────────────────────────────────────────────────────────────────────────────
// Example 8: Control Flow and Pattern Matching
// ─────────────────────────────────────────────────────────────────────────────

fn processCommand(cmd: Command) -> CommandResult {
  match cmd {
    Command::Activate(personas) => {
      for persona in personas {
        activate(persona)
      }
      CommandResult::Success({ activated: personas.length })
    },
    Command::Deactivate(personas) => {
      for persona in personas {
        deactivate(persona)
      }
      CommandResult::Success({ deactivated: personas.length })
    },
    Command::Workflow(expr) if expr.isValid() => {
      let result = executeWorkflow(expr)
      CommandResult::Success({ workflow: result })
    },
    Command::Query(pql) => {
      let results = executeQuery(pql)
      CommandResult::Success({ results })
    },
    _ => CommandResult::Error(UnknownCommand(cmd))
  }
}


// ─────────────────────────────────────────────────────────────────────────────
// Example 9: Complex Workflow Expressions
// ─────────────────────────────────────────────────────────────────────────────

// Simple sequential workflow
let simple = ARCHI -> DEV -> SEC

// Parallel analysis with merge
let parallel = (ARCHI || SEC || AUDIT) -> merge(Consensus)

// Conditional branching
let conditional = if securityRequired then SEC -> AUDIT else DEV

// Loop with condition
let iterative = loop (CRITIC -> DEV) until approved

// Complex composition
let complex = 
  ARCHI 
  -> (SEC || AUDIT || LTC) 
  -> merge(Debate) 
  -> CRITIC 
  -> if criticalIssues 
     then (SEC -> ARCHI -> merge(Consensus))
     else DEV


// ─────────────────────────────────────────────────────────────────────────────
// Example 10: Commands (PCL/Lite Compatible)
// ─────────────────────────────────────────────────────────────────────────────

// Activation commands
@activate SEC ARCHI CRITIC
@deactivate AUDIT
@clear
@spawn 3xSEC

// Configuration commands
@primary SEC
@merge Debate
@weights SEC=0.4, ARCHI=0.3, CRITIC=0.3
@quorum 2/3
@topic "Security review for PR #123"

// Cognitive parameters
@depth 4
@verbosity 2
@tone formal
@output markdown
@lang en

// Workflow commands
@workflow ARCHI -> SEC -> CRITIC
@workflow save review = ARCHI -> (SEC || AUDIT) -> CRITIC
@workflow run review

// Team commands
@team load SecurityReview
@team list
@team show SecurityReview

// State commands
@status
@export JSON
@snapshot save checkpoint1
@snapshot restore checkpoint1

// Observability
@trace on
@audit strict
@metrics
@profile start


// ─────────────────────────────────────────────────────────────────────────────
// Example 11: Error Handling
// ─────────────────────────────────────────────────────────────────────────────

fn safeOperation() -> Result<Data, PCLError> {
  try {
    @activate ARCHI SEC
    
    let analysis = await SEC.analyze(target)
    
    if analysis.riskScore > 8 {
      throw SecurityError("Risk score too high")
    }
    
    @workflow run CodeReview
    
    return Ok(analysis.data)
  } catch SecurityError(e) {
    log.error("Security issue detected", e)
    @fallback SIMPLIFY
    return Err(e)
  } catch WorkflowTimeout(e) {
    @workflow cancel e.workflowId
    return Err(TimeoutError("Operation timed out"))
  } finally {
    @cleanup
    @trace off
  }
}


// ─────────────────────────────────────────────────────────────────────────────
// Example 12: Async/Await and Concurrency
// ─────────────────────────────────────────────────────────────────────────────

async fn parallelAnalysis(targets: Array<String>) -> Array<AnalysisResult> {
  // Parallel execution with Promise.all equivalent
  let results = await Promise.all(
    targets.map(async (target) => {
      @isolate SEC
      return await SEC.analyze(target)
    })
  )
  
  // Merge results
  return results.filter(r => r.ok).map(r => r.value)
}

async fn streamingAnalysis(
  targets: AsyncIterator<String>
) -> AsyncIterator<AnalysisResult> {
  for await target in targets {
    yield await SEC.analyze(target)
  }
}


