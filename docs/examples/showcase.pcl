// ─────────────────────────────────────────════════════════════════════════════
// Example 14: PQL (Persona Query Language)
// ─────────────────────────────────────────────════════════════════════════════

// Query personas by domain
@query SELECT * FROM personas WHERE domain == "security"

// Find personas with specific skills
@query SELECT id, name FROM personas WHERE skills contains "OWASP"

// Join with teams
@query SELECT p.id, t.name 
       FROM personas p 
       JOIN teams t ON p.id IN t.members 
       WHERE t.merge == "Debate"

// Aggregate by tone
@query SELECT tone, COUNT(*) as count 
       FROM personas 
       GROUP BY tone 
       ORDER BY count DESC


// ─────────────────────────────────────────────────────────────────────════════
// Example 15: Complete Application
// ─────────────────────────────────────────────────────────────────────════════

/// Main entry point for a PCL-based code review system
module CodeReviewSystem {
  
  // Import personas
  import { SEC, AUDIT, COMPLIANCE } from "@pcl/security"
  import { DEV, ARCHI, CRITIC } from "@pcl/engineering"
  
  // Define custom personas
  pub persona REVIEWER extends DEV implements Reviewable {
    intent: "Review code changes with expertise"
    tone: analytical
    
    skills {
      @Foundation.CodeReview
      "Language-specific patterns"
      "Performance optimization"
      "Code smell detection"
    }
    
    pub async fn review(pr: PullRequest) -> ReviewResult {
      // Analyze the PR
      let analysis = await analyze(pr)
      
      // Check security if needed
      if pr.touchesSensitiveFiles {
        let secAnalysis = await SEC.analyze(pr)
        analysis = merge(analysis, secAnalysis)
      }
      
      return ReviewResult {
        approved: analysis.issues.length == 0,
        comments: analysis.suggestions,
        score: calculateScore(analysis)
      }
    }
  }
  
  // Define the main workflow
  pub workflow MainReview {
    input: PullRequest
    output: ReviewResult
    
    steps: REVIEWER -> (SEC || ARCHI) -> CRITIC -> merge(Consensus)
    
    timeout: 5m
    retry: 2
    fallback: SIMPLIFY
  }
  
  // Entry function
  pub async fn main(pr: PullRequest) -> Result<ReviewResult, Error> {
    // Initialize
    @activate REVIEWER
    @depth 4
    @trace on
    
    // Run the workflow
    let result = await @workflow run MainReview with pr
    
    // Cleanup
    @clear
    @trace off
    
    return Ok(result)
  }
}
